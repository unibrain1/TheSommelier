# Copy this file to .env and set the values. Use plain values.
#
# To keep secrets in 1Password, write op:// references as values and start
# the pipeline with: op run --env-file=.env -- bash fetch.sh
# The pipeline stops if a required value still starts with op://.
#
# A feature turns on when all its settings are present. A feature with no
# settings (HA_ENABLED) turns on only when its flag is a true value. Remove the "# "
# from the lines of each feature that you use.
# Set <FEATURE>_ENABLED=false to turn a feature off. A flag accepts
# true, false, 1, 0, yes and no. An empty or other value turns the feature
# off and logs a warning.

# --- Required ---

# CellarTracker credentials
USERNAME=your_cellartracker_username
PASSWORD=your_cellartracker_password

# Google Calendar secret .ics URL
GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/example/private-token/basic.ics

# --- Morning digest email ---
# On when SMTP_USERNAME, SMTP_PASSWORD and DIGEST_RECIPIENTS are set.
# DIGEST_ENABLED=false stops only the email. The digest files are still made.
# SMTP_USERNAME=sender@example.com
# SMTP_PASSWORD=your_smtp_password
# Comma-separated list
# DIGEST_RECIPIENTS=user@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Default: the value of SMTP_USERNAME
# SMTP_FROM=sender@example.com
# DIGEST_ENABLED=true

# --- Tasting notes and menu enrichment (Claude) ---
# On when CLAUDE_CODE_OAUTH_TOKEN is set and the claude CLI is installed.
# Do not set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN. The claude CLI uses
# them before the OAuth token, so the runs go on the API bill.
# CLAUDE_CODE_OAUTH_TOKEN=your_claude_oauth_token
# CLAUDE_ENABLED=true

# --- CellarTracker community notes ---
# RSS feed URL. It holds a token.
# CT_COMMUNITY_NOTES_RSS=https://www.cellartracker.com/rssnote.asp?CK=your_token
# COMMUNITY_NOTES_ENABLED=true

# --- Healthchecks.io ---
# The ping goes to HEALTHCHECK_BASE_URL/HEALTHCHECK_PING_KEY/HEALTHCHECK_SLUG.
# A failed run adds /fail.
# HEALTHCHECK_PING_KEY=your_ping_key
# HEALTHCHECK_SLUG=the-sommelier
# HEALTHCHECK_BASE_URL=https://hc-ping.com
# HEALTHCHECK_ENABLED=true

# --- Folders ---
# DATA_DIR default: /data. SITE_DIR default: $DATA_DIR/site.
# bash fetch.sh sets them to the data/ and site/ folders of the repo.
# In Docker, do not set them. The volumes are at the defaults. The
# the-sommelier container stops if SITE_DIR is not /data/site. The run-now
# service does not check it.
# DATA_DIR=/data
# SITE_DIR=/data/site

# --- Plan settings ---
# PLAN_CONFIG default: /config/plan.yaml. bash fetch.sh sets config/plan.yaml
# in the repo. If the file is missing, the plan uses the default holidays.
# In Docker, do not set it. The container reads /config/plan.yaml from the
# ./config mount. Sample: config/plan.yaml.sample.
# PLAN_CONFIG=/config/plan.yaml

# --- Container health check ---
# Maximum age in minutes of $SITE_DIR/plan.json before the container is
# unhealthy. Optional. Default: 600. A value that is not a positive integer
# gives the default and logs a warning.
# HEALTH_MAX_AGE_MINUTES=600

# --- Schedules and host ---
# SYNC_SCHEDULE=
# DIGEST_SEND_SCHEDULE=
# TZ=America/Los_Angeles

# Home Assistant reads thisweek.json and today.json from the site with a REST
# sensor. Default: off. When it is off, the pipeline removes both files.
# HA_ENABLED=true

# Public base URL of the site (optional). The digest email uses
# SITE_URL/logo.png only if site/logo.png is missing from the code folder.
# SITE_URL="https://sommelier.example.com"
